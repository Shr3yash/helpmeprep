---
import { getCollection } from "astro:content";
import Article from "../../layouts/Article.astro";
import { companyRouteId } from "../../lib/pages";
import { siteBase } from "../../lib/site";

export async function getStaticPaths() {
  const companies = await getCollection("companies");
  return companies.map((entry) => ({
    params: { slug: companyRouteId(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const base = siteBase();
const companies = (await getCollection("companies")).sort((a, b) => a.data.order - b.data.order);
---
<Article entry={entry} pager={false}>
  <div slot="before">
    <nav class="tabs" aria-label="Companies">
      {companies.map((c) => (
        <a href={`${base}companies/${companyRouteId(c)}`} aria-current={c.id === entry.id ? "page" : undefined}>{c.data.title}</a>
      ))}
    </nav>
    <p class="meta-row">
      <span class="pill">{entry.data.role}</span>
      <span class="pill">{entry.data.when}</span>
      <span class="pill">{entry.data.where}</span>
    </p>
    {entry.data.rounds.map((round) => (
      <section class="round">
        <h2>{round.name}</h2>
        <p class="when">{round.duration} · {round.format}</p>
        <h3>What's scored</h3>
        <ul>{round.scored.map((item) => <li>{item}</li>)}</ul>
        <h3>Checklist</h3>
        <ul>{round.checklist.map((item) => <li>{item}</li>)}</ul>
        <h3>Linked topics</h3>
        <ul>
          {round.topics.map((topic) => (
            <li><a href={`${base}${topic.replace(/^\//, "")}`}>{topic}</a></li>
          ))}
        </ul>
        <h3>Practice</h3>
        <ul>{round.practice.map((item) => <li>{item}</li>)}</ul>
      </section>
    ))}
  </div>
</Article>
